/* 贺见旅拍 · 青绿山水·胶片 2.0
   深青底 + 暖金 + 青碧；卡片以细描边和层次色区分，不堆重阴影。 */
page {
  width: 100%;
  min-height: 100%;
  background: #061817;
  color: #F2F0E8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  -webkit-font-smoothing: antialiased;
  --bg: #061817;
  --bg-deep: #041110;
  --bg-card: #0B2322;
  --bg-card-2: #0E2A28;
  --gold: #F2D08C;
  --gold-bright: #F7DCA4;
  --gold-deep: #DFB96F;
  --gold-ink: #2A1F0F;
  --teal: #5FE0CF;
  --teal-deep: #38BFAF;
  --line: rgba(126, 190, 176, .16);
  --line-strong: rgba(126, 190, 176, .28);
  --muted: #8FA9A4;
  --text: #F2F0E8;
  --danger: #E78B7F;
  --r-sm: 14rpx;
  --r-md: 22rpx;
  --r-lg: 30rpx;
  --r-pill: 999rpx;
  --f-xs: 20rpx;
  --f-sm: 23rpx;
  --f-md: 26rpx;
  --f-lg: 32rpx;
  --f-xl: 44rpx;
}

button {
  position: static;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  min-height: 0;
  min-width: 0;
  width: auto;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  color: inherit;
  background: transparent;
  border-radius: 0;
  overflow: visible;
}
button::after { border: 0; }

.p2 {
  min-height: 100vh;
  box-sizing: border-box;
  background: radial-gradient(120% 62% at 50% 0%, #0A2A28 0%, #061817 48%, #041110 100%);
}
.with-action { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 32rpx;
  padding-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.brand { font-family: 'STSong', 'SimSun', serif; font-size: 36rpx; letter-spacing: 5rpx; color: #EFD5A6; }
.back { font-size: 56rpx; line-height: 1; padding: 0 20rpx 4rpx 0; color: var(--text); }
.page-content { padding: 20rpx 30rpx; }
.page-title { display: block; font-size: 46rpx; font-weight: 700; line-height: 1.22; margin: 6rpx 0 8rpx; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.page-intro { display: block; font-size: 25rpx; color: var(--muted); line-height: 1.65; margin-bottom: 26rpx; }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.page-heading .page-title { flex: 1; }
.section-title { display: block; font-size: 31rpx; font-weight: 600; line-height: 1.4; letter-spacing: 0; }
.section-sub { display: block; font-size: 23rpx; color: var(--muted); line-height: 1.5; }
.section-head { display: flex; align-items: baseline; gap: 14rpx; margin: 34rpx 0 18rpx; }
.muted { display: block; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.ai-badge {
  display: inline-flex; align-items: center; padding: 3rpx 12rpx; margin-left: 10rpx;
  border: 1rpx solid rgba(242, 208, 140, .45); border-radius: 999rpx;
  background: rgba(242, 208, 140, .12); color: var(--gold);
  font-size: 18rpx; line-height: 1.5; letter-spacing: 1rpx; vertical-align: middle;
}
.ai-notice {
  display: flex; align-items: flex-start; gap: 10rpx; margin: 20rpx 0 0;
  padding: 16rpx 20rpx; border: 1rpx dashed rgba(242, 208, 140, .35);
  border-radius: 14rpx; background: rgba(242, 208, 140, .06);
  color: #D9CBA6; font-size: 21rpx; line-height: 1.55;
}
.ai-dot { flex: 0 0 auto; width: 8rpx; height: 8rpx; margin-top: 10rpx; border-radius: 50%; background: var(--gold); }
.gold { color: var(--gold); }
.card-surface {
  background: linear-gradient(180deg, rgba(17, 45, 43, .92), rgba(8, 27, 26, .96));
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

.primary {
  width: 100%;
  min-height: 100rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(120deg, #F8DFA9 0%, #F2D08C 48%, #E2BC74 100%);
  color: var(--gold-ink);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.5;
  white-space: nowrap;
  box-shadow: 0 14rpx 34rpx rgba(226, 188, 116, .2), inset 0 1rpx 0 rgba(255, 255, 255, .5);
}
.primary[disabled], .shoot[disabled] {
  background: #333F3C;
  color: #85938E;
  border-color: transparent;
  box-shadow: none;
  opacity: .85;
}
.secondary {
  width: 100%;
  border: 1rpx solid rgba(242, 208, 140, .45);
  background: rgba(242, 208, 140, .04);
  color: var(--gold);
  border-radius: var(--r-pill);
  line-height: 1.5;
  padding: 16rpx 22rpx;
  font-size: 25rpx;
}
.text-button { background: transparent; color: #D4D7D2; line-height: 1.6; padding: 14rpx 10rpx; font-size: 25rpx; border-radius: var(--r-pill); }
.fixed-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(4, 17, 16, .92), #041110 40%);
  border-top: 1rpx solid rgba(126, 190, 176, .12);
  z-index: 10;
}
.empty-state {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 36rpx 20rpx;
  line-height: 1.7;
}
.notice { padding: 22rpx 24rpx; background: rgba(231, 139, 127, .12); border: 1rpx solid rgba(231, 139, 127, .32); border-radius: var(--r-md); color: #F0C4BC; line-height: 1.6; margin: 16rpx 0; overflow-wrap: break-word; }

/* 线性图标：统一用内联 SVG，避免额外图片资源。 */
.ic {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}
