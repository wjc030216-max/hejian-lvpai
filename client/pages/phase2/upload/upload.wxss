@import "../../../styles/phase2-v2.wxss";

.upload-page.with-action { padding-bottom: calc(216rpx + env(safe-area-inset-bottom)); }

.template-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
}
.template-thumb {
  width: 132rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #0A1B1A;
}
.template-info { flex: 1; min-width: 0; }
.template-head { display: flex; align-items: flex-start; gap: 16rpx; }
.template-name { flex: 1; min-width: 0; display: block; font-size: 30rpx; font-weight: 600; line-height: 1.35; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.change-pill {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--gold);
  font-size: 22rpx;
  line-height: 1.4;
}
.template-meta { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--gold); }
.template-hook {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.mode-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.mode-card {
  position: relative;
  padding: 24rpx 20rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: rgba(8, 27, 26, .58);
  overflow: hidden;
}
.mode-card.chosen {
  border-color: var(--gold);
  background: linear-gradient(180deg, rgba(242, 208, 140, .1), rgba(8, 27, 26, .72));
}
.mode-check {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--gold);
  color: var(--gold-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
.mode-check-mark { color: var(--gold-ink); font-size: 24rpx; font-weight: 700; line-height: 1; }
.mode-illus {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  height: 96rpx;
  margin: 4rpx 0 16rpx;
}
.fig {
  position: relative;
  width: 52rpx;
  height: 70rpx;
  border-radius: 24rpx 24rpx 10rpx 10rpx;
  background: #7EA7B2;
}
.fig::before {
  content: '';
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #7EA7B2;
}
.fig-live { background: var(--gold); }
.fig-live::before { background: var(--gold); }
.fig-ghost { opacity: .22; }
.mode-name-row { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.mode-name { font-size: 28rpx; font-weight: 600; }
.mode-badge {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: var(--gold);
  color: var(--gold-ink);
  font-size: 18rpx;
  line-height: 1.4;
}
.mode-desc {
  display: block;
  min-height: 64rpx;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--muted);
  text-align: center;
}
.mode-explanation { display: block; margin-top: 12rpx; font-size: 21rpx; line-height: 1.6; color: #7F918C; }

.role-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.roles-1 { grid-template-columns: 1fr; }
.role-card {
  width: auto;
  min-width: 0;
  max-width: none;
  text-align: left;
}
.role-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
  margin-bottom: 12rpx;
}
.role-icon { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; }
.role-icon .ic { width: 28rpx; height: 28rpx; }
.role-head .role-name { display: inline; margin: 0; font-size: 28rpx; font-weight: 600; }
.ghost-icon { opacity: .36; }
.role-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--gold);
  color: var(--gold-ink);
  font-size: 18rpx;
  line-height: 1.5;
}
.role-tag.switch { background: transparent; border: 1rpx solid rgba(242, 208, 140, .5); color: var(--gold); }
.role-tag.chosen { background: rgba(242, 208, 140, .14); color: var(--gold); border: 1rpx solid rgba(242, 208, 140, .4); }

.upload-box {
  position: relative;
  height: 208rpx;
  border: 1rpx dashed rgba(126, 190, 176, .42);
  border-radius: 16rpx;
  background: rgba(7, 24, 23, .6);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-box.has-photo { border-style: solid; border-color: var(--line-strong); }
.upload-box.uses-template { border-color: rgba(126, 190, 176, .2); background: rgba(7, 24, 23, .4); }
.upload-image { width: 100%; height: 100%; display: block; }
.upload-empty { display: flex; flex-direction: column; align-items: center; gap: 6rpx; color: var(--gold); }
.upload-empty .ic-plus { margin-bottom: 4rpx; }
.upload-hint { font-size: 25rpx; color: #E8E3D6; }
.upload-format { font-size: 19rpx; color: #7F918C; }
.replace-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 0;
  background: rgba(0, 0, 0, .58);
  color: #fff;
  font-size: 21rpx;
  text-align: center;
}
.face-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
}
.face-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #6A7470; flex-shrink: 0; }
.face-status.passed { color: #9FD8C9; }
.face-status.passed .face-dot { background: var(--teal); }
.face-status.rejected { color: #EFA59B; }
.face-status.rejected .face-dot { background: var(--danger); }
.face-status.checking { color: var(--gold); }
.face-status.checking .face-dot {
  background: transparent;
  border: 3rpx solid var(--gold);
  border-top-color: transparent;
  box-sizing: border-box;
  animation: face-spin 1s linear infinite;
}
@keyframes face-spin { to { transform: rotate(360deg); } }
.reject-reason {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(231, 139, 127, .12);
  border: 1rpx solid rgba(231, 139, 127, .4);
  color: #EFA59B;
  font-size: 20rpx;
  line-height: 1.5;
}
.check-hint { display: block; color: #7F918C; font-size: 20rpx; margin-top: 8rpx; line-height: 1.5; }

.remaining-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 0 22rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: rgba(8, 27, 26, .55);
}
.remaining-count { font-size: 23rpx; color: var(--gold); }
.remaining-hint { font-size: 20rpx; color: var(--muted); }

.package-card { margin-top: 30rpx; padding: 24rpx; }
.package-head { display: flex; align-items: center; gap: 12rpx; }
.package-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(242, 208, 140, .1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.package-icon .ic { width: 28rpx; height: 28rpx; }
.package-items { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; }
.package-item { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.asset-icon {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(242, 208, 140, .35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.asset-icon .ic { width: 30rpx; height: 30rpx; }
.package-text { min-width: 0; }
.package-name { display: block; font-size: 25rpx; font-weight: 600; }
.package-desc { display: block; margin-top: 4rpx; font-size: 19rpx; color: var(--muted); }
.package-plus { flex-shrink: 0; color: var(--gold); font-size: 30rpx; }

.pay-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 24rpx;
}
.pay-main { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; flex: 1; }
.pay-label { font-size: 22rpx; color: #A9BCB2; letter-spacing: 1rpx; white-space: nowrap; }
.pay-value { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.pay-amount { font-size: 40rpx; font-weight: 700; color: var(--gold); line-height: 1.1; white-space: nowrap; }
.pay-original { font-size: 22rpx; color: rgba(232, 227, 214, .45); text-decoration: line-through; }
.pay-quota { display: flex; align-items: center; gap: 8rpx; margin-top: 2rpx; font-size: 20rpx; color: #8FA79B; white-space: nowrap; }
.pay-quota-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--gold); }
.pay-secure {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .06);
  font-size: 19rpx;
  color: #A9BCB2;
  white-space: nowrap;
}
.pay-secure .ic { width: 26rpx; height: 26rpx; }

.consent-card { margin-top: 20rpx; padding: 24rpx; }
.consent-main { display: flex; align-items: flex-start; gap: 14rpx; }
.consent-text { font-size: 23rpx; line-height: 1.7; color: #C8D2CD; }
.consent-tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.consent-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  font-size: 18rpx;
  color: var(--muted);
}
.consent-tag + .consent-tag { border-left: 1rpx solid var(--line); }
.consent-tag .ic { width: 21rpx; height: 21rpx; }

.upload-action { padding-top: 16rpx; }
.action-checklist {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
  font-size: 19rpx;
  color: var(--muted);
}
.check-item { display: flex; align-items: center; gap: 4rpx; opacity: .4; }
.check-item.on { opacity: 1; color: #C8D2CD; }
.check-item .ic-check { width: 20rpx; height: 20rpx; }
.check-divider { color: rgba(126, 190, 176, .28); font-size: 18rpx; }

@media (max-width: 350px) {
  .template-name { font-size: 31rpx; }
  .mode-card { padding: 20rpx 14rpx 16rpx; }
  .mode-name { font-size: 27rpx; }
  .mode-badge { font-size: 17rpx; }
  .mode-desc { font-size: 19rpx; min-height: 58rpx; }
  .upload-box { height: 186rpx; }
  .package-name { font-size: 23rpx; }
  .package-desc { font-size: 18rpx; }
  .consent-tag { font-size: 17rpx; }
}
