/* 分享页是公开落地页，使用独立、字面量样式，不依赖 CSS 变量/grid/inset。 */
page { background: #061817; color: #F2F0E8; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }

button { position: static; box-sizing: border-box; margin: 0; padding: 0; min-height: 0; min-width: 0; width: auto; font-size: 26rpx; line-height: 1.5; text-align: center; color: inherit; background: transparent; border-radius: 0; overflow: visible; }
button::after { border: 0; }

.share-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: radial-gradient(120% 60% at 50% 0%, #0A2A28 0%, #061817 48%, #041110 100%);
}
.share-nav { display: flex; align-items: center; gap: 12rpx; padding-left: 32rpx; padding-bottom: 16rpx; font-size: 30rpx; font-weight: 600; color: #F2F0E8; white-space: nowrap; }
.share-back { font-size: 56rpx; line-height: 1; padding: 0 20rpx 4rpx 0; color: #F2F0E8; }
.share-nav-title { line-height: 1.4; }
.share-content { padding: 18rpx 32rpx; }
.share-head { margin-bottom: 26rpx; }
.share-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 40rpx; font-weight: 700; line-height: 1.28; letter-spacing: 0; }
.share-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; font-size: 24rpx; color: #8FA9A4; }
.share-dot { opacity: .5; }
.share-hook { display: block; margin-top: 12rpx; font-size: 25rpx; color: #B9C6C1; line-height: 1.6; }
.share-empty { min-height: 260rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #F2F0E8; line-height: 1.7; }
.share-notice {
  padding: 22rpx 24rpx;
  background: rgba(231, 139, 127, .12);
  border: 1rpx solid rgba(231, 139, 127, .32);
  border-radius: 22rpx;
  color: #F0C4BC;
  line-height: 1.6;
  margin: 16rpx 0;
  overflow-wrap: break-word;
}
.share-assets { display: flex; gap: 20rpx; }
.share-asset { flex: 1; min-width: 0; }
.share-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 133.3333%;
  background: #0B2322;
  border: 1rpx solid rgba(126, 190, 176, .18);
  box-sizing: border-box;
  border-radius: 20rpx;
  overflow: hidden;
}
.share-frame-media { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.share-frame-empty {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #9FB3AD;
  font-size: 23rpx;
}
.share-symbol { font-size: 48rpx; color: #F2D08C; }
.share-asset-label { display: block; font-size: 27rpx; font-weight: 600; margin: 16rpx 0 0; text-align: center; }
.share-btn {
  border: 1rpx solid rgba(242, 208, 140, .45);
  background: rgba(242, 208, 140, .04);
  color: #F2D08C;
  border-radius: 999rpx;
  line-height: 1.5;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  width: 100%;
  margin-top: 14rpx;
}
.share-primary-inline {
  width: 100%;
  min-height: 96rpx;
  margin-top: 30rpx;
  padding: 22rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #F8DFA9 0%, #F2D08C 48%, #E2BC74 100%);
  color: #2A1F0F;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.5;
}
.share-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(4, 17, 16, .92), #041110 40%);
  border-top: 1rpx solid rgba(126, 190, 176, .12);
  z-index: 10;
}
.share-primary {
  width: 100%;
  min-height: 100rpx;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #F8DFA9 0%, #F2D08C 48%, #E2BC74 100%);
  color: #2A1F0F;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.5;
}
