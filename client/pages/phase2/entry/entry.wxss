@import "../../../styles/phase2-v2.wxss";

/* 竖屏样片铺满，信息与操作浮在底部。 */
.home-page { position: relative; height: 100vh; overflow: hidden; }
.home-page .nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  background: linear-gradient(180deg, rgba(3, 12, 11, .62), rgba(3, 12, 11, 0));
}
.home-top {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}
.top-pill {
  box-sizing: border-box;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  background: rgba(7, 22, 21, .58);
  border: 1rpx solid rgba(255, 255, 255, .2);
  color: #F2F0E8;
  font-size: 23rpx;
  line-height: 1;
  white-space: nowrap;
}
.top-pill .ic { width: 30rpx; height: 30rpx; }
.top-pill-text { max-width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.home-top .works-pill { width: auto; }
.mute-btn {
  box-sizing: border-box;
  flex: 0 0 68rpx;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(7, 22, 21, .58);
  border: 1rpx solid rgba(255, 255, 255, .2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mute-btn .ic { width: 32rpx; height: 32rpx; }
.chip-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: var(--gold);
  color: var(--gold-ink);
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
}
.chip-dot.alert { background: var(--danger); color: #3B1B17; }

.template-swiper { position: absolute; inset: 0; width: 100%; height: 100%; }
.stage-media { position: absolute; inset: 0; z-index: 1; }
.stage-placeholder { background: #102820; }
.stage-vignette {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 42%, rgba(2, 10, 9, .3) 100%);
}
.play-pill { bottom: auto; top: 42%; z-index: 3; }

.home-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 5;
  padding: 220rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(4, 17, 16, 0) 0%, rgba(4, 17, 16, .52) 26%, rgba(4, 17, 16, .92) 66%, #041110 100%);
}
.template-caption { display: block; }
.film-title { color: #F7F5ED; font-size: 44rpx; letter-spacing: 0; }
.film-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 10rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(242, 240, 232, .7);
}
.film-meta .sep { opacity: .45; }
.film-hook { color: rgba(242, 240, 232, .84); font-size: 26rpx; margin-top: 12rpx; }
.home-actions {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0 2rpx;
}
.round-action-slot {
  width: 104rpx;
  flex: 0 0 104rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  overflow: hidden;
}
.round-action {
  box-sizing: border-box;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  flex: 0 0 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(242, 240, 232, .78);
  font-size: 20rpx;
  line-height: 1.3;
}
.round-action-slot .round-action {
  width: 104rpx !important;
  min-width: 104rpx !important;
  max-width: 104rpx !important;
}
.action-bubble {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(7, 22, 21, .55);
  border: 1rpx solid rgba(255, 255, 255, .16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-bubble .ic { width: 34rpx; height: 34rpx; }
.shoot {
  box-sizing: border-box;
  flex: 0 0 430rpx;
  width: 430rpx;
  min-width: 430rpx;
  max-width: 430rpx;
  height: 96rpx;
  padding: 0 26rpx;
  gap: 8rpx;
  font-size: 29rpx;
  position: relative;
  z-index: 1;
  overflow: hidden;
}
.shoot .ic { width: 34rpx; height: 34rpx; }
.shoot-price { font-size: 27rpx; font-weight: 700; letter-spacing: 0; }
.shoot-loading { font-size: 27rpx; font-weight: 700; letter-spacing: 0; }
.shoot.is-disabled {
  background: #333F3C;
  color: #85938E;
  border-color: transparent;
  box-shadow: none;
  opacity: .85;
}

.home-empty {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
  gap: 24rpx;
  padding: 40rpx;
  text-align: center;
}
.home-empty > .secondary { max-width: 380rpx; }

.guide-card {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 46%;
  transform: translateY(-50%);
  z-index: 20;
  padding: 40rpx 34rpx;
  border-radius: 30rpx;
  background: linear-gradient(170deg, rgba(20, 54, 51, .98), rgba(7, 25, 24, .99));
  border: 1rpx solid rgba(242, 208, 140, .32);
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, .5);
}
.guide-badge { display: inline-block; padding: 6rpx 18rpx; font-size: 20rpx; color: var(--gold-ink); background: var(--gold); border-radius: 999rpx; margin-bottom: 24rpx; }
.guide-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.35; letter-spacing: 0; color: #F7F5ED; }
.guide-sub { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.7; color: var(--muted); }
.guide-cta { margin-top: 32rpx; width: 100%; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 999rpx; background: linear-gradient(120deg, #F8DFA9, #E2BC74); color: var(--gold-ink); font-weight: 700; font-size: 29rpx; }
.guide-cta::after { border: 0; }

.swipe-guide {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  pointer-events: none;
}
.swipe-hand {
  font-size: 160rpx;
  line-height: 1;
  animation: hand-swipe 1.4s ease-in-out infinite;
  filter: drop-shadow(0 10rpx 24rpx rgba(0, 0, 0, .55));
}
.swipe-guide-text {
  background: rgba(3, 12, 11, .68);
  color: #F2F0E8;
  font-size: 26rpx;
  line-height: 1;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
}
@keyframes hand-swipe {
  0%, 100% { transform: translateY(-42rpx); opacity: .68; }
  50% { transform: translateY(42rpx); opacity: 1; }
}

.side-nav {
  position: fixed;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 6;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.side-nav-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(7, 22, 21, .55);
  border: 1rpx solid rgba(255, 255, 255, .18);
  color: var(--gold);
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-panel { padding: 2rpx 0 18rpx; }
.filter-grid { display: flex; align-items: stretch; gap: 10rpx; }
.filter-picker { flex: 1 1 0; min-width: 0; }
.filter-field {
  box-sizing: border-box;
  height: 88rpx;
  padding: 12rpx 14rpx 10rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: rgba(12, 34, 32, .8);
  overflow: hidden;
}
.filter-field.on { border-color: rgba(242, 208, 140, .8); background: rgba(242, 208, 140, .1); }
.filter-field-head { display: flex; align-items: center; justify-content: space-between; gap: 4rpx; }
.filter-label { color: #8FA49D; font-size: 18rpx; line-height: 1.2; white-space: nowrap; }
.filter-caret { color: #AAB8B2; font-size: 18rpx; line-height: 1; }
.filter-field.on .filter-label, .filter-field.on .filter-caret { color: #E9CFA0; }
.filter-value { display: block; margin-top: 8rpx; overflow: hidden; color: #F2F0E8; font-size: 23rpx; font-weight: 600; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
.card-sample-btn { display: inline-block; margin-top: 12rpx; padding: 8rpx 18rpx; border: 1rpx solid rgba(242, 208, 140, .45); border-radius: 999rpx; color: var(--gold); font-size: 21rpx; }

.home-bottom { animation: rise .45s ease; }
@keyframes rise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }

@media (max-height: 680px) {
  .home-bottom { padding-top: 170rpx; padding-bottom: calc(12rpx + env(safe-area-inset-bottom)); }
  .film-title { font-size: 40rpx; }
  .film-hook { font-size: 22rpx; margin-top: 8rpx; }
  .home-actions { padding-top: 18rpx; }
  .shoot { height: 86rpx; font-size: 26rpx; }
  .action-bubble { width: 66rpx; height: 66rpx; }
  .round-action { width: 92rpx; }
}
@media (max-width: 350px) {
  .top-pill { padding: 0 14rpx; font-size: 21rpx; }
  .top-pill-text { max-width: 120rpx; }
  .home-top { gap: 10rpx; }
  .round-action-slot { width: 88rpx; flex: 0 0 88rpx; }
  .round-action { width: 88rpx; min-width: 88rpx; max-width: 88rpx; flex: 0 0 88rpx; }
  .round-action-slot .round-action { width: 88rpx !important; min-width: 88rpx !important; max-width: 88rpx !important; }
  .shoot { font-size: 25rpx; padding: 0 18rpx; }
  .shoot-price { font-size: 24rpx; }
}

.home-logo {
  position: absolute;
  left: 30rpx;
  z-index: 6;
  display: flex;
  align-items: center;
}
.home-logo-img {
  height: 92%;
  width: auto;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, .45));
}
