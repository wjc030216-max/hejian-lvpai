# 通联支付 W06S 凭证
# 只放服务器 /opt/hejian-lvpai/allinpay.env，权限 600，不要进仓库、不要打进发布包。
# 修改后重启主节点：
#   cd /opt/hejian-lvpai && python3 infra/staging/start_node.py main             # 代码有更新时
#   cd /opt/hejian-lvpai && python3 infra/staging/start_node.py main --no-build    # 只改了凭证时
#
# 支付开关仍在 .env.main 的 PHASE2_PAYMENT_MODE（dev-bypass / allinpay）。

# 环境：production=正式密钥，test=测试密钥。密钥与域名必须配套，填错启动会直接失败。
ALLINPAY_ENV=production   # 换成正式密钥后用 production；测试密钥用 test

# 接口地址留空就按 ALLINPAY_ENV 自动选：
#   test       -> https://interfacetest.allinpaygx.com
#   production -> https://interface.allinpaygx.com
# 除非通联另行分配了专用域名，否则保持注释。
# ALLINPAY_API_URL=
# ALLINPAY_REFUND_API_URL=
ALLINPAY_REFUND_VERSION=v1.0

ALLINPAY_MERCHANT_NO=CHANGE_ME_MERCHANT_NO
ALLINPAY_SECRET_KEY=CHANGE_ME_SECRET_KEY
ALLINPAY_CASHIER_APPID=wxef277996acc166c3
ALLINPAY_NOTIFY_URL=https://api.example.com/api/v2/payments/allinpay/notify
