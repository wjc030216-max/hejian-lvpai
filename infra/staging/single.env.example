# 单机部署环境变量（复制为 .env.single，放到 /opt/hejian-lvpai/.env.single）
#
# 用法：
#   cp infra/staging/single.env.example .env.single
#   # 按注释填完所有 CHANGE_ME 后：
#   docker compose --env-file .env.single -f infra/docker-compose.single.yml up -d --build
#
# 注意：
#   1. PHASE2_DB_PASSWORD 会被拼进数据库 URL，密码里若有 @ : / # 等字符必须 URL 编码。
#   2. APP_ENV=staging 时 PHASE2_DB_NAME 必须是 aitravel_phase2_test（代码强制校验）。
#   3. 切正式环境时把 APP_ENV 改为 production、数据库名去掉 test、支付必须是 allinpay。
#   4. 本文件含密钥，不要提交到仓库，不要打进发布包。

# ---------- 基础 ----------
COMPOSE_PROJECT_NAME=hejian-lvpai-single
APP_ENV=staging
LOCAL_CLOUD_ENABLED=true

# ---------- 数据库 ----------
# APP_ENV=staging 时必须为 aitravel_phase2_test
PHASE2_DB_NAME=aitravel_phase2_test
PHASE2_DB_USER=phase2_test
PHASE2_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- 域名与媒体令牌 ----------
# 微信小程序请求域名，必须是备案通过的 HTTPS 域名，不能带端口
TEST_DOMAIN=api.hejianlvpai.com
# 64 位十六进制：openssl rand -hex 32
LOCAL_MEDIA_TOKEN=CHANGE_ME_64_HEX

# ---------- 服务间与用户令牌 ----------
# 至少 32 字符：openssl rand -hex 32
AITRAVEL_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# ---------- 微信小程序 ----------
WECHAT_APP_ID=CHANGE_ME_WECHAT_APP_ID
WECHAT_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal

# ---------- 支付（staging 可用 dev-bypass；production 必须 allinpay）----------
PHASE2_PAYMENT_MODE=allinpay
# 通联商户号/密钥/收银台 AppID/回调地址已拆分到项目根目录的 allinpay.env（权限 600，不进仓库）。
# 切换 PHASE2_PAYMENT_MODE=allinpay 时，allinpay.env 必须填全，否则 main 启动校验会失败。
# 留空启用 9.90 / 16.90 / 19.90 分档价；填数字（分）则三档统一覆盖价
AITRAVEL_AIVIDEO_PRICE_FEN=
# 免费名额活动：全局先到先得，0 或留空表示关闭。名额用完后按上面价格收费。
PHASE2_FREE_QUOTA_TOTAL=0

# ---------- 阿里云人脸 ----------
ALIBABA_CLOUD_ACCESS_KEY_ID=CHANGE_ME_ALIYUN_AK_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=CHANGE_ME_ALIYUN_AK_SECRET
ALIYUN_FACE_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
ALIYUN_FACE_REGION=cn-shanghai

# ---------- 火山方舟：Seedream 生图 ----------
SEEDREAM_API_KEY=CHANGE_ME_SEEDREAM_KEY
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# ---------- 火山方舟：Seedance 视频 + 资产库 ----------
SEEDANCE_API_KEY=CHANGE_ME_SEEDANCE_KEY
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_ASSET_ACCESS_KEY_ID=CHANGE_ME_SEEDANCE_ASSET_AK
SEEDANCE_ASSET_ACCESS_KEY_SECRET=CHANGE_ME_SEEDANCE_ASSET_SK
SEEDANCE_ASSET_GROUP_ID=CHANGE_ME_SEEDANCE_GROUP_ID
SEEDANCE_ASSET_PROJECT_NAME=default

# ---------- 火山 TOS ----------
TOS_ACCESS_KEY_ID=CHANGE_ME_TOS_AK
TOS_ACCESS_KEY_SECRET=CHANGE_ME_TOS_SK
TOS_SECURITY_TOKEN=
TOS_BUCKET=CHANGE_ME_TOS_BUCKET
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# 必须落在当前环境命名空间下：staging → phase2-test/，production → phase2-prod/
# 可以再加子目录，例如 phase2-test/hejian-lvpai/
TOS_KEY_PREFIX=phase2-test/hejian-lvpai/
TOS_OBJECT_RETENTION_DAYS=90

# ---------- 运营管理台 ----------
ADMIN_USERNAME=admin
# 生成方式：
#   cd server && python -c "from common.admin_password import password_hash; print(password_hash('你的密码'))"
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
# openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET
ADMIN_MEDIA_TOKEN_SECONDS=43200

# ---------- 可选调优（不填用 compose 默认值）----------
# PHASE2_ORCHESTRATOR_WORKERS=64
# SERVICE_THREADS=64
# PHASE2_VIDEO_MAX_INFLIGHT=40
# CHARACTER_GENERATION_WORKERS=200
# VIDEO_GENERATION_WORKERS=40
# SEEDREAM_SERVICE_THREADS=500
# CHANNEL_TIMEOUT=120
# PHASE2_LOG_RETENTION_SECONDS=0

# ---------- 路径（相对 compose 所在目录）----------
# TLS_DIR=./tls
# IMPORT_DIR=./imports
# WECHAT_PAY_CERT_DIR=./certs
