# Reference only. Use prepare_configs.py to generate matching values.
APP_ENV=staging
MAIN_PRIVATE_IP=10.0.0.12
AI_PRIVATE_IP=10.0.0.13
DATA_PRIVATE_IP=10.0.0.11
AITRAVEL_JWT_SECRET=CHANGE_ME
LOCAL_CLOUD_ENABLED=false
AITRAVEL_DATABASE_URL=mysql+pymysql://phase2_test:CHANGE_ME@10.0.0.11:13306/aitravel_phase2_test?charset=utf8mb4
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_BASE_URL=https://api.example.com/media/CHANGE_ME
PHASE2_DB_NAME=aitravel_phase2_test
PHASE2_DB_USER=phase2_test
PHASE2_DB_PASSWORD=CHANGE_ME
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal
TEST_DOMAIN=api.example.com
REDIS_URL=redis://:CHANGE_ME@10.0.0.11:16379/2
LOCAL_MEDIA_TOKEN=CHANGE_ME

# Payment. Set PHASE2_PAYMENT_MODE=allinpay to enable the W06S cashier;
# dev-bypass keeps local development without charging. Put the merchant
# private key / cert / platform public key under ./certs (git-ignored).
PHASE2_PAYMENT_MODE=dev-bypass
# 通联商户号/密钥/收银台 AppID/回调地址已拆分到项目根目录的 allinpay.env（权限 600，不进仓库）。
# 切换 PHASE2_PAYMENT_MODE=allinpay 时，allinpay.env 必须填全，否则 main 启动校验会失败。
WECHAT_PAY_APPID=wx1234567890abcdef
WECHAT_PAY_MCHID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v2/payments/notify
# Optional flat override. Leave empty to use 9.90 / 16.90 / 19.90 tiers.
AITRAVEL_AIVIDEO_PRICE_FEN=10
# Free-slot campaign: first-come-first-served across all orders; 0 disables it.
PHASE2_FREE_QUOTA_TOTAL=0
PHASE2_AGREEMENT_VERSION=travel-photo-v1
PHASE2_CORS_ORIGINS=
PHASE2_PROJECTS_PER_HOUR=30
PHASE2_UPLOADS_PER_10_MINUTES=30
PHASE2_SUBSCRIBE_MAX_ATTEMPTS=8
PHASE2_USER_RETENTION_DAYS=90
PHASE2_LOG_RETENTION_SECONDS=0
PHASE2_ORCHESTRATOR_WORKERS=128
PHASE2_PROJECT_DB_POOL_SIZE=32
PHASE2_PROJECT_DB_MAX_OVERFLOW=16
PHASE2_TASK_MAX_SECONDS=7200
PHASE2_PROJECT_MAX_SECONDS=7200
PHASE2_RETENTION_BATCH_SIZE=100
PHASE2_RETENTION_INTERVAL_SECONDS=300
PHASE2_RETENTION_TIME_BUDGET_SECONDS=240
