# 复制为 .env 并按需填写；不要提交真实密钥
APP_ENV=local
PHASE2_AUTH_MODE=local
AITRAVEL_JWT_SECRET=change-me-64-hex
AITRAVEL_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/aitravel?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/2
PUBLIC_API_BASE_URL=http://127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080/media/change-me
LOCAL_MEDIA_TOKEN=change-me
PHASE2_PAYMENT_MODE=disabled
PHASE2_FREE_QUOTA_TOTAL=0

# 云端（本地联调时按需开启）
LOCAL_CLOUD_ENABLED=false
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_ASSET_ACCESS_KEY_ID=
SEEDANCE_ASSET_ACCESS_KEY_SECRET=
SEEDANCE_ASSET_GROUP_ID=
SEEDANCE_ASSET_PROJECT_NAME=default
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 对象存储
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
TOS_KEY_PREFIX=
TOS_SIGNED_URL_TTL_SECONDS=3600

# 管理台
ADMIN_JWT_SECRET=change-me
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin

# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=
